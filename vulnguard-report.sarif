{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "VulnGuard",
          "informationUri": "https://github.com/AbhiN3m0/vulnguard",
          "version": "0.4.0",
          "rules": [
            {
              "id": "PY-EVAL-001",
              "name": "Dangerous eval usage",
              "shortDescription": {
                "text": "Dangerous eval usage"
              },
              "fullDescription": {
                "text": "Avoid eval()."
              },
              "properties": {
                "severity": "HIGH",
                "owasp": "A03:2021 Injection"
              }
            },
            {
              "id": "JS-EVAL-001",
              "name": "Dangerous eval usage",
              "shortDescription": {
                "text": "Dangerous eval usage"
              },
              "fullDescription": {
                "text": "Avoid eval()."
              },
              "properties": {
                "severity": "HIGH",
                "owasp": "A03:2021 Injection"
              }
            },
            {
              "id": "JS-DOCWRITE-001",
              "name": "document.write usage",
              "shortDescription": {
                "text": "document.write usage"
              },
              "fullDescription": {
                "text": "Avoid document.write."
              },
              "properties": {
                "severity": "MEDIUM",
                "owasp": "A03:2021 Injection"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "PY-EVAL-001",
          "level": "error",
          "message": {
            "text": "Dangerous eval usage - Avoid eval()."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "test.py"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ]
        },
        {
          "ruleId": "JS-EVAL-001",
          "level": "error",
          "message": {
            "text": "Dangerous eval usage - Avoid eval()."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "test.js"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "JS-DOCWRITE-001",
          "level": "warning",
          "message": {
            "text": "document.write usage - Avoid document.write."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "test.js"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ]
        }
      ]
    }
  ]
}